[Unit]
Description=Coding agents and everything they start: sessions and jobs

# Two children share this: agents-sessions.slice (Claude Code, Codex, herdr
# and their subagents) and agents-jobs.slice (CI, builds, tests, servers,
# browsers, renders). Agents yield to the desktop: under contention they get
# a fifth of the CPU and disk time an app gets. MemoryMax is the outer
# safety net that keeps the desktop alive; oomd watches the children, not
# this slice, so a job's pressure never kills a session.
[Slice]
CPUWeight=20
IOWeight=20
MemoryLow=16G
MemoryMax=54G
MemorySwapMax=16G
