[Unit]
Description=Nightly competitor benchmark of Chat with Work's main on GPT-6 Luna (bin/competitor-evals-nightly)

[Service]
Type=oneshot
Slice=agents.slice
# A checkout of its own that follows origin/main, whatever the working one has checked out.
WorkingDirectory=%h/Work/chatwithwork-nightly
# A login shell, so mise, Ruby, the credentials and gh are on the PATH.
ExecStart=/usr/bin/fish -l -c 'git fetch --quiet origin main; and git checkout --quiet --detach origin/main; and bin/competitor-evals-nightly'
