state_file = "auto"
engine = "parakeet"

[hotkey]
enabled = false
key = "HOME"
mode = "push_to_talk"

[audio]

# Pause MPRIS media players during recording
pause_media = {{ if eq .chezmoi.os "darwin" }}false{{ else }}true{{ end }}
device = "default"
sample_rate = 16000
# Long dictations need Parakeet windowing (crmne integration build, PR #891)
max_duration_secs = {{ if eq .chezmoi.os "darwin" }}600{{ else }}1800{{ end }}
duck_media = false
duck_media_volume_percent = 70
duck_media_fade_ms = 150

[audio.feedback]
enabled = true
# Sound theme: "default", "subtle", "mechanical", or path to custom theme directory
theme = "default"
volume = 1.0

[whisper]
model = "small.en"
language = "en"
translate = false
on_demand_loading = false
gpu_isolation = false
flash_attention = true
eager_processing = false
mode = "local"

[output]
mode = "paste"
fallback_to_clipboard = true

# Delay between typed characters in milliseconds
# 0 = fastest possible, increase if characters are dropped
type_delay_ms = 2
auto_submit = false
shift_enter_newlines = false
pre_type_delay_ms = 0

[output.notification]
on_recording_start = false
on_recording_stop = false
on_transcription = true
show_engine_icon = true

[text]
replacements = { "hyperwhisper" = "hyprwhspr" }
spoken_punctuation = false
smart_auto_submit = false

[status]
icon_theme = "omarchy"

[parakeet]
# Full-precision model on the NVIDIA desktop, int8 on CPU-only machines
model = {{ if and (eq .chezmoi.os "linux") (lookPath "nvidia-smi") }}"parakeet-tdt-0.6b-v3"{{ else }}"parakeet-tdt-0.6b-v3-int8"{{ end }}
streaming = false
on_demand_loading = false

[vad]
enabled = false
backend = "auto"
threshold = 0.5

[meeting]
enabled = false

[meeting.diarization]
enabled = false

[meeting.audio]
source = "mic"

[osd]
enabled = {{ if eq .chezmoi.os "darwin" }}false{{ else }}true{{ end }}
frontend = "native"
style = "default"
layout = "compact"
position = "bottom-center"
width_px = 400
height_px = 48
margin_px = 24
top_margin = 0.85
opacity = 0.95
waveform_window_secs = 3.0
peak_decay_db_per_sec = 6.0
waveform_gain = 10.0
