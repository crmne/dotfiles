{{- /* gws's Desktop OAuth client, in the GCP project carmine-gws (crmne/terraform, gcp/gws.tf). */ -}}
{{- $item := "op://Personal/gws OAuth client" -}}
{{- $id := output "op-cache" "read" (printf "%s/client_id" $item) | trim -}}
{{- $secret := output "op-cache" "read" (printf "%s/client_secret" $item) | trim -}}
{{ dict "installed" (dict
  "client_id" $id
  "client_secret" $secret
  "project_id" "carmine-gws"
  "auth_uri" "https://accounts.google.com/o/oauth2/auth"
  "token_uri" "https://oauth2.googleapis.com/token"
  "auth_provider_x509_cert_url" "https://www.googleapis.com/oauth2/v1/certs"
  "redirect_uris" (list "http://localhost")
) | toJson }}
