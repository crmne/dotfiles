{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

# Create the managed paths before applying the configuration. mkdir -p keeps
# existing directories and working Nextcloud symlinks intact.
{{ include "dot_config/private_user-dirs.dirs" }}

mkdir -p \
  "$XDG_DESKTOP_DIR" "$XDG_DOWNLOAD_DIR" "$XDG_TEMPLATES_DIR" \
  "$XDG_PUBLICSHARE_DIR" "$XDG_DOCUMENTS_DIR" "$XDG_MUSIC_DIR" \
  "$XDG_PICTURES_DIR" "$XDG_VIDEOS_DIR" "$XDG_PROJECTS_DIR"
{{ end -}}
