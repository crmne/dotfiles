#!/bin/sh
# Fisher installs and updates the fish plugins in fish_plugins (Fisher itself,
# fzf.fish, fish-direnv and omafish), so chezmoi keeps only that list and
# reruns this when it changes.
# fish_plugins: {{ include "dot_config/private_fish/fish_plugins" | sha256sum }}
set -eu
command -v fish >/dev/null 2>&1 || exit 0
exec fish -c '
  if not functions -q fisher
    curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
  end
  fisher update'
